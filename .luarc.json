{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "runtime": {
    "version": "Lua 5.5",
    "path": ["?.lua", "?/init.lua", "packages/*/src/?.lua", "packages/*/src/?/init.lua"]
  },
  "workspace": {
    "library": [],
    "ignoreDir": [".hecate", "spikes", "website", "node_modules"],
    "checkThirdParty": false
  },
  "diagnostics": {
    "globals": [],
    "severity": {
      "undefined-global": "Error",
      "lowercase-global": "Error"
    }
  },
  "type": {
    "weakNilCheck": false
  }
}
