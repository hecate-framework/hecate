# hecate/runtime, debian variant: Lua 5.5, LuaRocks, libuv, OpenSSL and the system CA certificates, to run applications.
# Build from the repository root: docker build -f docker/runtime/Dockerfile.debian .
# Specification: docs/architecture/versioning-and-distribution.md#docker-images

ARG DEBIAN_TAG=bookworm-slim

# Stage 1: Lua and LuaRocks, built from the pinned sources with verified checksums (tools/bootstrap/bootstrap.sh).
FROM debian:${DEBIAN_TAG} AS toolchain
RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential ca-certificates curl libreadline-dev unzip \
 && rm -rf /var/lib/apt/lists/*
COPY tools/bootstrap/bootstrap.sh /tmp/bootstrap.sh
RUN bash /tmp/bootstrap.sh --prefix /opt/lua-5.5

# Stage 2: the runtime, without compilers.
FROM debian:${DEBIAN_TAG}
ARG LUA_VERSION=5.5
ARG HECATE_VERSION=0.0.0-dev
LABEL org.opencontainers.image.title="hecate/runtime" \
      org.opencontainers.image.description="Runtime image for Hecate applications" \
      org.opencontainers.image.source="https://github.com/hecate-framework/hecate" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.version="${HECATE_VERSION}" \
      org.hecate.lua-version="${LUA_VERSION}"
# System CA certificates: the default trust store of hecate.net is the operating system's (ADR 0024).
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates libuv1 libssl3 libreadline8 \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd --system --gid 10001 hecate \
 && useradd --system --uid 10001 --gid hecate --create-home --home-dir /app --shell /usr/sbin/nologin hecate
COPY --from=toolchain /opt/lua-5.5 /opt/lua-5.5
ENV PATH=/opt/lua-5.5/bin:$PATH
WORKDIR /app
USER hecate
CMD ["lua", "-v"]
