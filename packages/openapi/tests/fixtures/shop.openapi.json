            "description": "An explanation specific to this occurrence (section 3.1.4).",
            "type": "string"
          },
          "instance": {
            "description": "A URI reference that identifies this occurrence (section 3.1.5).",
            "format": "uri-reference",
            "type": "string"
          },
          "status": {
            "description": "The HTTP status code of this occurrence (section 3.1.2).",
            "maximum": 599,
            "minimum": 100,
            "type": "integer"
          },
          "title": {
            "description": "A short, human-readable summary of the problem type (section 3.1.3).",
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "description": "A URI reference that identifies the problem type (RFC 9457 section 3.1.1).",
            "format": "uri-reference",
            "type": "string"
          }
        },
        "type": "object"
      },
      "User": {
