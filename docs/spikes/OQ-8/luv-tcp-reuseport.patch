diff --git a/src/tcp.c b/src/tcp.c
index 2c2734d..f39b672 100644
--- a/src/tcp.c
+++ b/src/tcp.c
@@ -124,6 +124,11 @@ static int luv_tcp_bind(lua_State* L) {
     lua_getfield(L, 4, "ipv6only");
     if (lua_toboolean(L, -1)) flags |= UV_TCP_IPV6ONLY;
     lua_pop(L, 1);
+#if LUV_UV_VERSION_GEQ(1, 49, 0)
+    lua_getfield(L, 4, "reuseport");
+    if (lua_toboolean(L, -1)) flags |= UV_TCP_REUSEPORT;
+    lua_pop(L, 1);
+#endif
   }
   ret = uv_tcp_bind(handle, (struct sockaddr*)&addr, flags);
   return luv_result(L, ret);
diff --git a/tests/test-tcp.lua b/tests/test-tcp.lua
index dddb74c..60ec201 100644
--- a/tests/test-tcp.lua
+++ b/tests/test-tcp.lua
@@ -26,6 +26,30 @@ return require('lib/tap')(function (test)
     p{client=client,req=req}
   end)
 
+  test("tcp servers can share a port with reuseport", function (print, p, expect, uv)
+    local first = uv.new_tcp()
+    local ok, err = uv.tcp_bind(first, "127.0.0.1", 0, {reuseport = true})
+    if not ok then
+      -- Not supported by the platform or by this libuv (ENOTSUP).
+      p("reuseport unavailable", err)
+      uv.close(first)
+      return
+    end
+    local port = uv.tcp_getsockname(first).port
+    local second = uv.new_tcp()
+    assert(uv.tcp_bind(second, "127.0.0.1", port, {reuseport = true}))
+    assert(uv.listen(first, 128, function () end))
+    assert(uv.listen(second, 128, function () end))
+    -- Without the flag the same port is taken.
+    local third = uv.new_tcp()
+    assert(uv.tcp_bind(third, "127.0.0.1", port))
+    local _, listen_err = uv.listen(third, 128, function () end)
+    assert(listen_err and listen_err:match("EADDRINUSE"), listen_err)
+    uv.close(first)
+    uv.close(second)
+    uv.close(third)
+  end)
+
